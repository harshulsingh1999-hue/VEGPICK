# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted (Cloud Run / Custom Domain).
APP_URL="MY_APP_URL"

# Multi-Server Identity (Cloud Run / Render / Fly.io replicas)
# Example: "node-1" for primary server, "node-2" for secondary backup server.
SERVER_REGION="asia-southeast1"
REPLICA_ID="node-1"

# L2 Distributed Cache & Rate Limiter (Upstash Console -> Database -> Details -> REST API)
# MUST start with https:// (do NOT paste rediss:// TCP URL here)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Relational Archive & SQL Analytics DB (Supabase Console -> Project Settings -> API)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional browser-side Supabase client (publishable key only; never put service_role here)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Zero-Egress Object Storage for Product & Proof Photos (Cloudflare R2 Free Tier)
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""

# Client-Side Multi-Server / Edge Failover List (Comma-separated HTTPS origins, no trailing slash)
# Leave blank "" when using same-origin /api/*, or add Worker/Backup URLs:
# e.g. "https://freshveggie-edge.workers.dev,https://ais-pre-mphtqhvp24i2rfhdzuywp5-8191345487.asia-southeast1.run.app"
VITE_API_SERVERS=""
