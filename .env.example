# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted (Cloud Run / Custom Domain).
APP_URL="MY_APP_URL"

# Multi-Server Identity (Cloud Run / Render / Fly.io replicas)
SERVER_REGION="asia-southeast1"
REPLICA_ID="node-1"

# L2 Distributed Cache & Rate Limiter (Upstash Redis Free Tier)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Relational Archive & SQL Analytics DB (Supabase PostgreSQL Free Tier)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Zero-Egress Object Storage for Product & Proof Photos (Cloudflare R2 Free Tier)
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""

# Client-Side Multi-Server / Edge Failover List (Comma-separated HTTPS origins)
VITE_API_SERVERS=""

